rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Users & Data Subcollections ──────────────────────────────────────────

    // User profile document
    match /users/{userId} {
      // Anyone logged in can view profiles (e.g. for collaboration / study groups)
      allow read: if isAuthenticated();
      // Only the account owner can modify their profile
      allow write: if isOwner(userId);

      // User's private courses
      match /courses/{courseId} {
        allow read, write: if isOwner(userId);
      }

      // User's private assignments
      match /assignments/{assignmentId} {
        allow read, write: if isOwner(userId);

        // Submissions & sub-deadlines
        match /submissions/{subId} {
          allow read, write: if isOwner(userId);
        }

        // Subtasks under assignment
        match /tasks/{taskId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // ─── Group Assignments ────────────────────────────────────────────────────

    match /groups/{groupId} {
      // Any authenticated user can read or join groups with valid access token
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated();
      // Only the group admin can delete the group
      allow delete: if isAuthenticated() && resource.data.adminUserId == request.auth.uid;
    }
  }
}

